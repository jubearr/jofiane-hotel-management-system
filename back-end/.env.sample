// insert nyo ung binigay ko na mongo_uri 
MONGO_URI=mongodb+srv://<username>:<password>@yourcluster.mongodb.net/JofianeHMS
PORT=5000 

# Secret used to sign JWT auth tokens. Use a long random string in production.
# REQUIRED in production — the server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed front-end origins for CORS.
# Defaults to http://localhost:3000 (the CRA dev server) if unset.
CORS_ORIGIN=http://localhost:3000

# Set to "production" to enforce production safety checks (e.g. required JWT_SECRET).
# NODE_ENV=production